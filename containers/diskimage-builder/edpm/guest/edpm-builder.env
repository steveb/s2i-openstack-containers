# DIB environment used by /init inside the build appliance VM.
#
# The package inventory is owned by Konflux: the target root filesystem
# comes from the frozen os_source tarball, and the only RPM repository
# visible inside the chroot is the local copy collected in the os_source
# stage (see elements/edpm-s2i/extra-data.d/05-local-repo).

DISTRO_NAME=centos
DIB_RELEASE=10-stream
YUM=dnf

DIB_TARBALL_PATH=/data/os_source.tar
DIB_AVOID_PACKAGES_UPDATE=1
DIB_EPEL_DISABLED=2

DIB_EDPM_REPO_DIR=/var/cache/edpm-repo

# The VM has real proc/sys/dev, so DIB creates its own filesystems rather
# than bind-mounting the host ones (DIB_BIND_MOUNTS). Build on the scratch
# disk instead of tmpfs to keep guest RAM usage low (DIB_NO_TMPFS).
DIB_NO_TMPFS=1
TMP_DIR=/work
# Keep repository caches off the in-RAM root filesystem
DIB_IMAGE_CACHE=/work/dib-cache

# Local elements first, then the elements installed from the
# edpm-image-builder wheel (pinned in sources.txt). That package provides
# edpm-base, edpm-partition-uefi and the other EDPM image elements.
ELEMENTS_PATH=/elements:/usr/share/edpm-image-builder/dib

DIB_DEBUG_TRACE=1
DIB_CHECKSUM=sha256
