#!/bin/bash
# dib-lint: disable=safe_sudo
# All paths passed to sudo are built from $TMP_MOUNT_PATH below.
# Undo extra-data.d/05-local-repo: restore the distribution repository
# configuration and drop the collected RPMs and build-only files, which are
# inputs to the build and must not end up in the image.

if [ "${DIB_DEBUG_TRACE:-0}" -gt 0 ]; then
    set -x
fi
set -eu
set -o pipefail

REPO_DIR="${DIB_EDPM_REPO_DIR:-/var/cache/edpm-repo}"
TARGET_REPOS_DIR="${TMP_MOUNT_PATH}/etc/yum.repos.d"

if [ -d "${TARGET_REPOS_DIR}.edpm-s2i-orig" ]; then
    sudo rm -rf "${TARGET_REPOS_DIR}"
    sudo mv -T "${TARGET_REPOS_DIR}.edpm-s2i-orig" "${TARGET_REPOS_DIR}"
else
    sudo rm -f "${TARGET_REPOS_DIR}/edpm-local.repo"
fi

sudo rm -rf "${TMP_MOUNT_PATH}${REPO_DIR}"
sudo rm -f "${TMP_MOUNT_PATH}/tmp/yum-blacklist"
