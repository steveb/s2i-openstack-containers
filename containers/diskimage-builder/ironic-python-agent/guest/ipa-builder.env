# DIB environment used by /init inside the build appliance VM.
#
# This mirrors the environment that was used when diskimage-builder ran in
# the container. The package inventory is still owned by Konflux: the target
# root filesystem comes from the frozen os_source tarball and all Python
# packages come from the pre-built wheels, so the VM never contacts a
# package repository.

DISTRO_NAME=centos
DIB_RELEASE=10-stream
YUM=dnf

DIB_TARBALL_PATH=/data/os_source.tar
DIB_AVOID_PACKAGES_UPDATE=1
DIB_EPEL_DISABLED=2
DIB_IPA_HARDWARE_RDO=0
DIB_IPA_HARDWARE_SYSBENCH=0
DIB_IPA_HARDWARE_GDISK=0
DIB_IPA_KEEP_RPMDB=1

DIB_IPA_WHEELS_DIR=/data/wheels
DIB_IPA_CONSTRAINTS_FILE=/data/deps-upper-constraints.txt

# The VM has real proc/sys/dev, so DIB creates its own filesystems rather
# than bind-mounting the host ones (DIB_BIND_MOUNTS). Build on the scratch
# disk instead of tmpfs to keep guest RAM usage low (DIB_NO_TMPFS).
DIB_NO_TMPFS=1
TMP_DIR=/work
# Keep repository caches off the in-RAM root filesystem
DIB_IMAGE_CACHE=/work/dib-cache

ELEMENTS_PATH=/elements
DIB_REPOLOCATION_ironic_python_agent=/data/src/ironic-python-agent
DIB_INSTALLTYPE_requirements=package
DIB_INSTALLTYPE_glean=package

DIB_DEBUG_TRACE=1
DIB_CHECKSUM=sha256

SOURCE_VERSION_STREAM=master
