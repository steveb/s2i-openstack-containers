#!/bin/bash
# Make the RPM repository collected in the os_source build stage the only
# repository available inside the chroot.
#
# The os_source image already contains every package the ramdisk needs, but
# diskimage-builder elements still ask the package manager to install their
# own package lists. Pointing dnf exclusively at the local repository keeps
# the build offline and lets those requests be satisfied from the frozen
# package set instead of being reduced to assertions.

if [ "${DIB_DEBUG_TRACE:-0}" -gt 0 ]; then
    set -x
fi
set -eu
set -o pipefail

REPO_DIR="${DIB_IPA_REPO_DIR:-/var/cache/ipa-repo}"
TARGET_REPOS_DIR="${TMP_MOUNT_PATH}/etc/yum.repos.d"

if [ ! -f "${TMP_MOUNT_PATH}${REPO_DIR}/repodata/repomd.xml" ]; then
    echo "ERROR: local RPM repository not found at ${REPO_DIR} in the image." >&2
    echo "The os_source stage must collect the RPMs listed in bindeps.txt" >&2
    echo "into ${REPO_DIR} and run createrepo_c on them." >&2
    exit 1
fi

# Move the distribution repository configuration out of the way. It is
# restored by cleanup.d/05-restore-yum-repos so that it does not influence
# the package installation in this build.
if [ -d "${TARGET_REPOS_DIR}" ]; then
    sudo mv -T "${TARGET_REPOS_DIR}" "${TARGET_REPOS_DIR}.ipa-s2i-orig"
fi
sudo mkdir -p "${TARGET_REPOS_DIR}"

# The RPMs are collected from the same repositories that build the os_source
# image, and the repository configuration used there disables GPG checking
# as well, so it is not re-enabled for the local copy.
sudo tee "${TARGET_REPOS_DIR}/ipa-local.repo" > /dev/null << EOF
[ipa-local]
name=ironic-python-agent image build packages
baseurl=file://${REPO_DIR}
enabled=1
gpgcheck=0
EOF
